# ---------------------------------------------------------------------------
# AdMiner — variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA versione o `.env.local`.
# ---------------------------------------------------------------------------

# --- Aplicação ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AdMiner"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Camada de dados ---------------------------------------------------------
# `memory`   -> repositórios em memória com dataset mockado (não exige Supabase).
# `supabase` -> repositórios Postgres/Supabase (exige as chaves abaixo).
DATA_DRIVER="memory"

# --- Provider de anúncios ----------------------------------------------------
# `mock` -> MockAdProvider (dataset sintético realista).
# `meta` -> MetaAdLibraryProvider (Meta Ad Library API oficial).
ADS_PROVIDER="mock"

# --- Supabase ----------------------------------------------------------------
# Públicas (expostas ao browser — apenas a anon key, protegida por RLS).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Privada — SOMENTE no servidor/worker. Jamais prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Meta Ad Library API (integração oficial) --------------------------------
# https://www.facebook.com/ads/library/api/
# Requer app Meta com a permissão `ads_read` e identidade verificada.
META_AD_LIBRARY_ACCESS_TOKEN=""
META_GRAPH_API_VERSION="v21.0"

# --- Camada de IA ------------------------------------------------------------
# `heuristic` -> análises determinísticas por regras (padrão, sem custo).
# `anthropic` | `openai` -> providers LLM.
AI_PROVIDER="heuristic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- Filas / jobs assíncronos ------------------------------------------------
# `memory` -> fila em processo (dev). `redis` -> BullMQ + Redis (produção).
JOB_DRIVER="memory"
REDIS_URL="redis://localhost:6379"

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="120"

# --- Billing (Stripe — arquitetura preparada, ainda não implementado) ---------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Administração -----------------------------------------------------------
# E-mails com acesso ao painel /admin, separados por vírgula.
ADMIN_EMAILS=""
