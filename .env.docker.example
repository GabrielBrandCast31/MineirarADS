# ---------------------------------------------------------------------------
# Variáveis do docker compose. Copie para `.env` na raiz:
#
#     cp .env.docker.example .env
#
# Só infraestrutura entra aqui. As variáveis da aplicação (DATA_DRIVER,
# NEXT_PUBLIC_SUPABASE_URL, …) são definidas dentro do próprio compose.yaml —
# assim rodar `npm run dev` fora do Docker continua caindo no modo demo, em
# vez de tentar falar com um Supabase que não está no ar.
# ---------------------------------------------------------------------------

# Perfil padrão do `docker compose up` sem flags.
# `--profile supabase` substitui este valor.
COMPOSE_PROFILES=demo

# --- Postgres --------------------------------------------------------------
POSTGRES_PASSWORD=postgres

# --- Chaves do Supabase local ----------------------------------------------
# ANON_KEY e SERVICE_ROLE_KEY são JWTs assinados com JWT_SECRET: os três
# andam juntos. Para trocar o segredo, regere o trio de uma vez:
#
#     node scripts/supabase-keys.mjs "seu-novo-segredo-com-32+-caracteres"
#
# Estes valores são de desenvolvimento local. Nunca use em produção.
JWT_SECRET=adminer-local-dev-jwt-secret-nao-use-em-producao
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRvY2tlciIsImlhdCI6MTc4ODI4MTgyNiwiZXhwIjoyMTAzNjQxODI2fQ.uuPzE_FtGnym9j-myrM7MWYyRbU-JJsEeKc4S-3WfMg
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZG9ja2VyIiwiaWF0IjoxNzg4MjgxODI2LCJleHAiOjIxMDM2NDE4MjZ9.1KbBNBkHkH4M9lBoZP5cpfXedwetk9UCInY5H-Ktv7I

# --- Aplicação (opcionais) -------------------------------------------------
# Deixe em branco para usar os providers determinísticos, sem custo nem rede.
ADS_PROVIDER=mock
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
META_AD_LIBRARY_ACCESS_TOKEN=
ADMIN_EMAILS=
